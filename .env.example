# Copie para .env e preencha antes de rodar ./deploy.sh

# Banco de dados
DB_USER=ccb_user
DB_PASSWORD=troque_por_senha_forte
DB_ROOT_PASSWORD=troque_por_senha_root_forte

# JWT
JWT_SECRET=troque_por_string_aleatoria_longa
JWT_EXPIRES_IN=7d

# CORS — origens permitidas (separadas por vírgula); em produção, coloque o domínio do Cloudflare
# Ex: FRONTEND_ORIGIN=https://meusite.example.com
# Em dev local não é necessário (padrão: localhost:5173 e localhost:8080)
FRONTEND_ORIGIN=

# (usado apenas em dev local — não necessário no Docker)
DATABASE_URL="mysql://ccb_user:senha@localhost:3306/ccb"
PORT=3000
NODE_ENV=production
